# Discord bot token (required)
# Get from https://discord.com/developers/applications -> Your App -> Bot -> Reset Token
DISCORD_TOKEN=your_bot_token_here

# Lavalink server (required for music playback)
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# Use wss:// for Lavalink over SSL (e.g. some Railway setups)
LAVALINK_SSL=false

# Set to true to use yt-dlp + FFmpeg instead of Lavalink (single service; requires FFmpeg)
USE_YTDLP_FALLBACK=false
